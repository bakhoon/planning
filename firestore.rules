rules_version = '2';

// 이 파일 전체를 Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 "게시"를 누르세요.
// 소유자 이메일을 바꾸려면 아래 OWNER 한 곳만 수정하면 됩니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner() {
      return signedIn() && myEmail() == 'joon7853@gmail.com';   // OWNER
    }

    function accessPath() {
      return /databases/$(database)/documents/config/access;
    }

    // 소유자이거나, config/access 문서의 emails 목록에 있는 이메일만 허용
    function isAllowed() {
      return isOwner()
        || (signedIn()
            && exists(accessPath())
            && myEmail() in get(accessPath()).data.emails);
    }

    // 허용 이메일 목록: 허용된 사람만 읽기, 소유자만 수정
    match /config/access {
      allow read: if isAllowed();
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['emails', 'updatedAt'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 50;
    }

    // 플래너 항목: 각자 자기 공간(users/{내 uid})만 읽고 쓰기
    match /users/{uid}/items/{itemId} {
      allow read, delete: if isAllowed() && request.auth.uid == uid;
      allow create, update: if isAllowed() && request.auth.uid == uid && validItem();
    }

    // 항목 형식 검사 (크기 제한으로 용량 폭주 방지)
    function validItem() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'type', 'date', 'time', 'note', 'done', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.type in ['할 일', '회의', '마감', '메모']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.size() <= 5
        && d.note is string && d.note.size() <= 2000
        && d.done is bool;
    }

    // 위에 적지 않은 경로는 전부 거부 (Firestore 기본값이지만 명시)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
