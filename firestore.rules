rules_version = '2';

// Paste this whole file into Firebase console > Firestore Database > Rules, then click "Publish".
// To change the owner email, edit only the line marked OWNER below.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner() {
      return signedIn() && myEmail() == 'joon7853@gmail.com';   // OWNER
    }

    function accessPath() {
      return /databases/$(database)/documents/config/access;
    }

    // Allowed: the owner, or any email listed in config/access.emails
    function isAllowed() {
      return isOwner()
        || (signedIn()
            && exists(accessPath())
            && myEmail() in get(accessPath()).data.emails);
    }

    // Allowlist: readable by allowed users, writable by the owner only
    match /config/access {
      allow read: if isAllowed();
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['emails', 'updatedAt'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 50;
    }

    // Planner items: each user can only read/write their own users/{uid} space
    match /users/{uid}/items/{itemId} {
      allow read, delete: if isAllowed() && request.auth.uid == uid;
      allow create, update: if isAllowed() && request.auth.uid == uid && validItem();
    }

    // Item validation (size limits keep storage from blowing up)
    function validItem() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'type', 'date', 'time', 'note', 'done', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.type in ['Task', 'Meeting', 'Deadline', 'Note']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.size() <= 5
        && d.note is string && d.note.size() <= 2000
        && d.done is bool;
    }

    // Everything not matched above is denied (Firestore's default, stated explicitly)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
