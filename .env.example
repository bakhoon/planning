# Copy from Firebase console > Project settings > Your apps > SDK setup and configuration
# Local dev: copy this file to .env.local and fill in the values
# GitHub deploy: add the same names under repo Settings > Secrets and variables > Actions > Variables
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Owner email (must match the email in firestore.rules)
VITE_OWNER_EMAIL=joon7853@gmail.com
