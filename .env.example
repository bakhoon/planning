# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성 에서 복사
# 로컬 개발: 이 파일을 .env.local 로 복사해서 값 채우기
# GitHub 배포: 레포 Settings > Secrets and variables > Actions > Variables 에 같은 이름으로 등록
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 소유자 이메일 (firestore.rules 안의 이메일과 반드시 같아야 함)
VITE_OWNER_EMAIL=joon7853@gmail.com
